       <!-- Step 1: Feature Selection Card -->
       <item>
        <widget class="QGroupBox" name="step1_group">
         <property name="title">
          <string>Step 1: Select Features</string>
         </property>
         <property name="styleSheet">
          <string notr="true">
QGroupBox {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 14px;
    padding: 16px;
    font-weight: bold;
    font-size: 13px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: white;
    color: #1a5f2a;
}
